@using Microsoft.AspNetCore.Components
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div style="min-height: 100vh; width: 100%; background-color: #960E53; color: white; display: flex; flex-direction: column; justify-content: space-between; padding: 40px; text-align: center;">

    <!-- logo principal -->
    <div style="margin-top: 20px;">
        <img src="@Config["UIParams:LogoPrincipal"]"
             alt="Logo Institución"
             style="width: 220px; max-width: 80%;" />
    </div>

    <!-- centro -->
    <div>
        <h2 class="fw-bold mb-4">
            @Config["UIParams:TituloPrincipal"]
        </h2>

        <p style="font-size: 1.1rem; line-height: 1.6; max-width: 500px; margin: 0 auto;">
            @Texto
        </p>
    </div>

    <!-- Pie de pagina -->
    <div class="d-flex align-items-center justify-content-center text-start" style="margin-bottom: 20px;">

        <img src="@Config["UIParams:LogoSecundario"]" class="me-3" style="width: 130px;" alt="Logo Secundario" />

        <div style="font-size: 0.85rem; border-left: 1px solid rgba(255,255,255,0.4); padding-left: 15px;">
            <strong>@Config["UIParams:Subtitulo"]</strong><br />
            @Config["UIParams:Direccion"]
        </div>

    </div>
</div>

@code {
    [Parameter]
    public string Texto { get; set; } = "";
}