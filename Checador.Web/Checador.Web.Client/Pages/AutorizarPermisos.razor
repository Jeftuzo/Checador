@page "/autorizar-permisos"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@using System.Net.Http.Json
@using Checador.Web.Client.Dtos.PermisosDtos
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Checador.Web.Client.Services.AuthState Auth

@if (!Auth.EstaAutenticado)
{
    <div class="p-5 text-center">Redirigiendo al login...</div>
}
else
{
    <div class="container-fluid p-0" style="min-height: 100vh;">
        <div class="row g-0" style="min-height: 100vh;">
            <div class="col-lg-5">
                <PanelInstitucional Texto="Gestión de solicitudes de permisos laborales." />
            </div>

            <div class="col-lg-7" style="background-color: #f4f6f9;">
                <div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh;">
                    <div class="card shadow-lg p-4 border-0">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h2 class="fw-bold mb-1" style="color: #960E53;">Autorizaciones</h2>
                                <p class="text-muted mb-0">Gestión de permisos de empleados</p>
                            </div>
                            <a href="/admin-index" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-shield-lock"></i> Panel Administrativo
                            </a>
                        </div>

                        <div class="alert alert-light border shadow-sm mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@Auth.PerfilActual!.NombreCompleto</strong>
                                    <span class="badge ms-2" style="background-color: #960E53;">@Auth.PerfilActual.Rol</span>
                                    <div class="text-muted small mt-1">@Auth.PerfilActual.NumeroEmpleado - @Auth.PerfilActual.Departamento</div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensaje))
                        {
                            <div class="alert @(esExito ? "alert-success" : "alert-danger")">@mensaje</div>
                        }

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0" style="color: #960E53;">@TituloTabla</h5>
                                    <button class="btn btn-sm btn-outline-success" @onclick="CargarPermisos">
                                        <i class="bi bi-arrow-clockwise"></i> Actualizar
                                    </button>
                                </div>
                            </div>

                            <div class="card-body p-0">
                                @if (cargandoPermisos)
                                {
                                    <div class="text-center py-5">
                                        <div class="spinner-border" style="color: #960E53;"></div>
                                        <div class="text-muted mt-2">Cargando permisos...</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover align-middle mb-0">
                                            <thead class="text-white" style="background-color: #960E53;">
                                                <tr>
                                                    <th>No. Empleado</th>
                                                    @if (PuedeVerOtros)
                                                    {
                                                        <th>Empleado</th>
                                                    }
                                                    <th>Fecha</th>
                                                    <th>Inicio</th>
                                                    <th>Fin</th>
                                                    <th>Motivo</th>
                                                    <th>Estado</th>
                                                    <th class="text-center">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (permisos.Any())
                                                {
                                                    @foreach (var permiso in permisos)
                                                    {
                                                        <tr>
                                                            <td><strong>@permiso.NumeroEmpleado</strong></td>
                                                            @if (PuedeVerOtros)
                                                            {
                                                                <td>@(permiso.Empleado?.NombreCompleto ?? permiso.NumeroEmpleado)</td>
                                                            }
                                                            <td>@permiso.Fecha.ToString("dd/MM/yyyy")</td>
                                                            <td>@permiso.HoraInicio.ToString("HH:mm")</td>
                                                            <td>@permiso.HoraFin.ToString("HH:mm")</td>
                                                            <td>@(string.IsNullOrWhiteSpace(permiso.Motivo) ? "Sin motivo" : permiso.Motivo)</td>
                                                            <td><span class="badge @ClaseEstado(permiso.Estado)">@permiso.Estado</span></td>
                                                            <td class="text-center">
                                                                @if (PuedeAutorizar && permiso.Estado == "Pendiente")
                                                                {
                                                                    <button class="btn btn-sm btn-success me-1" @onclick="() => CambiarEstado(permiso.Id, true)">Autorizar</button>
                                                                    <button class="btn btn-sm btn-danger" @onclick="() => CambiarEstado(permiso.Id, false)">Rechazar</button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="8" class="text-center text-muted py-5">
                                                            <i class="bi bi-folder2-open fs-1 d-block mb-2"></i> No hay permisos para mostrar.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string ApiBase = "api/Permisos";
    private List<PermisoDto> permisos = new();
    private bool cargandoPermisos = false;
    private bool procesando = false;
    private bool esExito = false;
    private string mensaje = "";

    private bool PuedeAutorizar => Auth.PerfilActual?.Rol == "RRHHAdmin" || Auth.PerfilActual?.Rol == "Admin" || Auth.PerfilActual?.Rol == "DirectorArea";
    private bool PuedeVerOtros => true;

    private string TituloTabla => Auth.PerfilActual?.Rol switch
    {
        "DirectorArea" => "Administración de Permisos de mi Área",
        "RRHH" => "Lectura de Todos los Empleados",
        "RRHHAdmin" => "Administración de Permisos",
        "Admin" => "Administración de Permisos",
        _ => "Permisos"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EstaAutenticado)
        {
            NavManager.NavigateTo("/login");
        }
        else
        {
            await CargarPermisos();
        }
    }

    private async Task CargarPermisos()
    {
        cargandoPermisos = true;
        try
        {
            string url = Auth.PerfilActual!.Rol switch
            {
                "DirectorArea" => $"{ApiBase}/area/{Auth.PerfilActual.NumeroEmpleado}",
                "RRHH" or "RRHHAdmin" or "Admin" => $"{ApiBase}/todos/{Auth.PerfilActual.NumeroEmpleado}",
                _ => $"{ApiBase}/mis-permisos/{Auth.PerfilActual.NumeroEmpleado}"
            };

            permisos = await Http.GetFromJsonAsync<List<PermisoDto>>(url) ?? new List<PermisoDto>();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar permisos: {ex.Message}";
            esExito = false;
            permisos = new();
        }
        finally
        {
            cargandoPermisos = false;
        }
    }

    private async Task CambiarEstado(int id, bool autorizar)
    {
        procesando = true;
        mensaje = "";
        try
        {
            var dto = new CambiarEstadoPermisoDto { NumeroEmpleadoAutoriza = Auth.PerfilActual!.NumeroEmpleado };
            string accion = autorizar ? "autorizar" : "rechazar";

            var respuesta = await Http.PutAsJsonAsync($"{ApiBase}/{id}/{accion}", dto);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = autorizar ? "Permiso autorizado correctamente." : "Permiso rechazado correctamente.";
                esExito = true;
                await CargarPermisos();
            }
            else
            {
                esExito = false;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            esExito = false;
        }
        finally
        {
            procesando = false;
        }
    }

    private string ClaseEstado(string estado) => estado switch
    {
        "Autorizado" => "bg-success",
        "Rechazado" => "bg-danger",
        "Cancelado" => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}