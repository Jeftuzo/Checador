@page "/permisos"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@using System.Net.Http.Json
@using Checador.Web.Client.Dtos.PermisosDtos
@inject HttpClient Http

<div class="container-fluid p-0" style="min-height: 100vh;">
    <div class="row g-0" style="min-height: 100vh;">
        <div class="col-lg-5">
            <PanelInstitucional Texto="Solicita y consulta tus permisos laborales." />
        </div>

        <div class="col-lg-7" style="background-color: #f4f6f9;">
            <div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh;">
                <div class="card shadow-lg p-4 border-0">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1" style="color: #960E53;">Solicitud de Permisos</h2>
                        </div>
                        <a href="/menu" class="btn btn-outline-secondary fw-bold">
                            <i class="bi bi-house-door"></i> Menú Principal
                        </a>
                    </div>

                    @if (perfil == null)
                    {
                        <div class="row justify-content-center py-5">
                            <div class="col-md-6 col-lg-5">
                                <div class="card border-0 shadow-sm p-4">
                                    <h4 class="fw-bold text-center mb-3">Identificación</h4>
                                    <p class="text-muted text-center">Ingrese su número de empleado para solicitar permisos.</p>
                                    <input type="text" class="form-control form-control-lg mb-3 text-center" @bind="numeroEmpleado" placeholder="Ej. E001" />
                                    <button class="btn btn-lg w-100 text-white fw-bold" style="background-color: #960E53;" disabled="@cargando" @onclick="CargarPerfil">
                                        @if (cargando)
                                        {
                                            <span>Cargando...</span>
                                        }
                                        else
                                        {

                                            <span>Ingresar</span>
                                        }
                                    </button>
                                    @if (!string.IsNullOrEmpty(mensaje))
                                    {
                                        <div class="alert alert-danger mt-3 text-center">@mensaje</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border shadow-sm mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@perfil.NombreCompleto</strong>
                                    <div class="text-muted small mt-1">@perfil.NumeroEmpleado - @perfil.Departamento</div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarSesion">Cambiar usuario</button>
                            </div>
                        </div>

                        <div class="alert alert-info mb-4">
                            <strong>Reglas de permisos:</strong> máximo <strong>3 permisos al mes</strong>, hasta <strong>2 horas por permiso</strong>, dentro del horario de <strong>8:00 AM a 3:00 PM</strong>.
                        </div>

                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white py-3">
                                <h5 class="fw-bold mb-0" style="color: #960E53;">Solicitar Permiso</h5>
                            </div>
                            <div class="card-body p-4">

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Fecha</label>
                                        <input type="date" @bind="fechaPermiso" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Hora Inicio</label>
                                        <div class="d-flex">
                                            <input type="text" class="form-control text-center px-2" placeholder="08:00" maxlength="5" value="@horaInicioText" @oninput="FormatearInicio" />
                                            <select class="form-select ms-2" @bind="amPmInicio" style="min-width: 85px; width: 85px;">
                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Hora Fin</label>
                                        <div class="d-flex">
                                            <input type="text" class="form-control text-center px-2" placeholder="10:00" maxlength="5" value="@horaFinText" @oninput="FormatearFin" />
                                            <select class="form-select ms-2" @bind="amPmFin" style="min-width: 85px; width: 85px;">
                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-12 mt-3">
                                        <label class="form-label fw-bold">Motivo</label>
                                        <input type="text" class="form-control" maxlength="500" placeholder="Motivo del permiso" @bind="nuevoPermiso.Motivo" />
                                    </div>
                                </div>

                                <div class="text-end mt-4">
                                    <button class="btn text-white fw-bold px-4 py-2" style="background-color: #960E53;" disabled="@procesando" @onclick="SolicitarPermiso">
                                        <i class="bi bi-plus-circle me-1"></i> Solicitar Permiso
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensaje))
                        {
                            <div class="alert @(esExito ? "alert-success" : "alert-danger") fw-bold text-center">@mensaje</div>
                        }

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0" style="color: #960E53;">Mis Permisos</h5>
                                    <button class="btn btn-sm btn-outline-success" @onclick="CargarPermisos"><i class="bi bi-arrow-clockwise"></i></button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover align-middle mb-0">
                                        <thead class="text-white" style="background-color: #960E53;">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Inicio</th>
                                                <th>Fin</th>
                                                <th>Motivo</th>
                                                <th>Estado</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (permisos.Any())
                                            {
                                                @foreach (var permiso in permisos)
                                                {
                                                    <tr>
                                                        <td>@permiso.Fecha.ToString("dd/MM/yyyy")</td>
                                                        <td>@permiso.HoraInicio.ToString("HH:mm")</td>
                                                        <td>@permiso.HoraFin.ToString("HH:mm")</td>
                                                        <td>@(string.IsNullOrWhiteSpace(permiso.Motivo) ? "Sin motivo" : permiso.Motivo)</td>
                                                        <td><span class="badge @ClaseEstado(permiso.Estado)">@permiso.Estado</span></td>
                                                        <td>
                                                            @if (permiso.Estado == "Pendiente")
                                                            {
                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelarPermiso(permiso.Id)">Cancelar</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="6" class="text-center text-muted py-4">No has solicitado ningún permiso.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string numeroEmpleado = "";
    private PerfilPermisoDto? perfil;
    private List<PermisoDto> permisos = new();
    private CrearPermisoDto nuevoPermiso = new();

    private bool cargando = false;
    private bool procesando = false;
    private bool esExito = false;
    private string mensaje = "";

    private DateTime fechaPermiso = DateTime.Today;

    private string horaInicioText = "08:00";
    private string amPmInicio = "AM";

    private string horaFinText = "10:00";
    private string amPmFin = "AM";

    private void FormatearInicio(ChangeEventArgs e)
    {
        horaInicioText = AplicarFormatoHora(e.Value?.ToString() ?? "", horaInicioText);
    }

    private void FormatearFin(ChangeEventArgs e)
    {
        horaFinText = AplicarFormatoHora(e.Value?.ToString() ?? "", horaFinText);
    }

    private string AplicarFormatoHora(string nuevoValor, string valorAnterior)
    {
        if (nuevoValor.Length < valorAnterior.Length) return nuevoValor;

        var numeros = new string(nuevoValor.Where(char.IsDigit).ToArray());
        if (numeros.Length > 4) numeros = numeros.Substring(0, 4);

        if (numeros.Length >= 3)
            return $"{numeros.Substring(0, 2)}:{numeros.Substring(2)}";
        if (numeros.Length == 2)
            return $"{numeros}:";

        return numeros;
    }

    private async Task CargarPerfil()
    {
        mensaje = "";
        if (string.IsNullOrWhiteSpace(numeroEmpleado)) { mensaje = "Ingrese un número de empleado."; return; }

        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync($"api/Permisos/perfil/{numeroEmpleado.Trim()}");
            if (!respuesta.IsSuccessStatusCode) { mensaje = "El número de empleado no está registrado."; return; }

            perfil = await respuesta.Content.ReadFromJsonAsync<PerfilPermisoDto>();
            if (perfil != null) await CargarPermisos();
        }
        catch (Exception ex) { mensaje = $"Error de conexión: {ex.Message}"; }
        finally { cargando = false; }
    }

    private async Task CargarPermisos()
    {
        if (perfil == null) return;
        try { permisos = await Http.GetFromJsonAsync<List<PermisoDto>>($"api/Permisos/mis-permisos/{perfil.NumeroEmpleado}") ?? new(); }
        catch { }
    }

    private async Task SolicitarPermiso()
    {
        if (perfil == null) return;

        if (!DateTime.TryParse($"{horaInicioText} {amPmInicio}", out DateTime dtInicio))
        {
            mensaje = "Error: La hora de inicio es incorrecta. Use formato HH:MM (Ej. 08:30).";
            esExito = false;
            return;
        }

        if (!DateTime.TryParse($"{horaFinText} {amPmFin}", out DateTime dtFin))
        {
            mensaje = "Error: La hora de fin es incorrecta. Use formato HH:MM (Ej. 10:00).";
            esExito = false;
            return;
        }

        nuevoPermiso.NumeroEmpleado = perfil.NumeroEmpleado;
        nuevoPermiso.Fecha = DateOnly.FromDateTime(fechaPermiso);
        nuevoPermiso.HoraInicio = TimeOnly.FromDateTime(dtInicio);
        nuevoPermiso.HoraFin = TimeOnly.FromDateTime(dtFin);

        procesando = true;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/Permisos", nuevoPermiso);
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Permiso solicitado correctamente.";
                esExito = true;
                nuevoPermiso.Motivo = "";
                await CargarPermisos();
            }
            else
            {
                var errorJson = await respuesta.Content.ReadAsStringAsync();
                mensaje = ObtenerMensajeApi(errorJson);
                esExito = false;
            }
        }
        catch (Exception) { mensaje = "Error de conexión con el servidor."; esExito = false; }
        finally { procesando = false; }
    }

    private async Task CancelarPermiso(int id)
    {
        if (perfil == null) return;
        try
        {
            var respuesta = await Http.PutAsync($"api/Permisos/{id}/cancelar/{perfil.NumeroEmpleado}", null);
            if (respuesta.IsSuccessStatusCode) await CargarPermisos();
        }
        catch { }
    }

    private string ObtenerMensajeApi(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("Mensaje", out var prop) || doc.RootElement.TryGetProperty("mensaje", out prop))
            {
                return prop.GetString() ?? "Elija un horario adecuado y revise sus datos.";
            }
        }
        catch { }
        return "Elija un horario adecuado y revise sus datos.";
    }

    private string ClaseEstado(string estado) => estado switch
    {
        "Autorizado" => "bg-success",
        "Rechazado" => "bg-danger",
        "Cancelado" => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    private void CerrarSesion()
    {
        perfil = null; permisos.Clear(); numeroEmpleado = ""; mensaje = "";
    }
}