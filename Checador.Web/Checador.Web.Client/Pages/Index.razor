@page "/menu"
@layout Checador.Web.Client.Layout.EmptyNavMenu

<div class="container-fluid p-0" style="min-height: 100vh;">
    <div class="row g-0" style="min-height: 100vh;">

        <div class="col-lg-5">
            <PanelInstitucional Texto="Sistema de control de asistencia y administración de permisos del personal." />
        </div>

        <div class="col-lg-7 d-flex align-items-center justify-content-center"
             style="background-color: #f4f6f9;">

            <div class="container px-4 py-5">

                <div class="text-center mb-5">
                    <h1 class="fw-bold"
                        style="color: #960E53;">
                        Sistema de Asistencia
                    </h1>

                    <p class="text-muted">
                        Seleccione el módulo al que desea acceder
                    </p>
                </div>

                <div class="row g-4 justify-content-center">

                    <!-- Asistencia -->       
                    <div class="col-md-4">
                        <div class="card shadow border-0 h-100 text-center p-4">

                            <div class="mb-3">
                                <i class="bi bi-person-check-fill"
                                   style="font-size: 4rem; color: #960E53;">
                                </i>
                            </div>

                            <h4 class="fw-bold">
                                Asistencia
                            </h4>

                            <p class="text-muted">
                                Registro de asistencia.
                            </p>

                            <a href="/"
                               class="btn text-white fw-bold mt-auto"
                               style="background-color: #960E53;">
                                Ir a la pantalla de asistencia
                            </a>

                        </div>
                    </div>


                    <!-- Pemisos -->
                    <div class="col-md-4">
                        <div class="card shadow border-0 h-100 text-center p-4">

                            <div class="mb-3">
                                <i class="bi bi-calendar-check"
                                   style="font-size: 4rem; color: #960E53;">
                                </i>
                            </div>

                            <h4 class="fw-bold">
                                Permisos
                            </h4>

                            <p class="text-muted">
                                Solicitar permisos.
                            </p>

                            <a href="/permisos"
                               class="btn text-white fw-bold mt-auto"
                               style="background-color: #960E53;">
                                Ir a Permisos
                            </a>

                        </div>
                    </div>


                    <!-- Administrativo -->
                    <div class="col-md-4">
                        <div class="card shadow border-0 h-100 text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-shield-lock-fill" style="font-size: 4rem; color: #960E53;"></i>
                            </div>
                            <h4 class="fw-bold">Administrativo</h4>
                            <p class="text-muted">Acceso a funciones administrativas.</p>
                            <a href="/login" class="btn text-white fw-bold mt-auto" style="background-color: #960E53;">
                                Iniciar Sesión
                            </a>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
</div>