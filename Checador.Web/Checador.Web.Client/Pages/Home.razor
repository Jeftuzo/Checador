@page "/"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@inject IJSRuntime JS
@using Checador.Web.Client.Dtos
@using Microsoft.AspNetCore.Components.Forms

<div class="container-fluid vh-100 p-0">
    <div class="row g-0 h-100">

        <div class="col-md-6 split-left text-center">

            <div>
                <!--<img src="images/logo-sonora-blanco.png" alt="Gobierno de Sonora" width="200" /> -->
            </div>

            <div>
                <h2 class="fw-bold mb-4">Registro Civil</h2>
                <p class="px-5" style="font-size: 1.1rem; line-height: 1.6;">
                    Sistema de asistencia. Ingresa tu número de empleado
                    y colócate frente a la cámara para registrar tu entrada o salida.
                </p>
            </div>

            <div class="d-flex align-items-center justify-content-center text-start">
                <!--<img src="images/logo-sonora-pequeno.png" class="me-3" width="100" /> -->
                <div style="font-size: 0.85rem; border-left: 1px solid rgba(255,255,255,0.3); padding-left: 15px;">
                    <strong>Dirección Genereal de Registro Civil</strong> Centro de Gobierno<br />
                    Edificio Sonora Sur Planta Baja, Blvd. Paseo Río Sonora y Comonfort, C.P. 83280<br />
                    Hermosillo, Sonora, México.
                </div>
            </div>

        </div>


        <div class="col-md-6 d-flex align-items-center justify-content-center bg-white">
            <div class="w-75 p-4">

                <h3 class="mb-4 text-center fw-bold" style="color: #333333;">Registrar Asistencia</h3>

                <div class="video-container mb-4 shadow-sm" style="background-color: #000; border-radius: 8px; overflow: hidden; height: 300px;">
                    <video id="videoFeed" width="100%" height="300" autoplay muted playsinline></video>
                    <canvas id="canvasOculto" width="400" height="300" style="display:none;"></canvas>
                </div>

                <EditForm Model="@registro" OnValidSubmit="ProcesarRegistro">
                    <DataAnnotationsValidator />

                    <div class="form-group mb-4 text-start">
                        <label for="numeroEmpleado" class="form-label fw-bold" style="color: #4D4D4D;">Número de Empleado</label>

                        <input type="text" id="numeroEmpleado" class="form-control form-control-lg text-center fw-bold"
                               placeholder="Ingresa tu número de empleado y presiona Enter" @bind-value="registro.NumeroEmpleado"
                               @ref="inputNumeroEmpleado" autofocus />

                        <ValidationMessage For="@(() => registro.NumeroEmpleado)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-agregar btn-lg w-100 py-3 fw-bold fs-5 shadow-sm" disabled="@procesando">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Procesando...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-person-check-fill"></i> Registrar</span>
                        }
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(mensajeResultado))
                {
                    <div class="alert @(esExito ? "alert-success" : "alert-danger") mt-4 fw-bold text-center" role="alert">
                        @mensajeResultado
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@code {
    private RegistroDto registro = new RegistroDto();
    private string mensajeResultado = "";
    private bool esExito = false;
    private bool procesando = false;

    private ElementReference inputNumeroEmpleado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(200);
            await JS.InvokeVoidAsync("iniciarCamara", "videoFeed");
        }
    }

    private async Task ProcesarRegistro()
    {
        procesando = true;
        mensajeResultado = "";

        try
        {
            string fotoBase64 = await JS.InvokeAsync<string>("capturaAutomatica", "videoFeed", "canvasOculto");

            if (string.IsNullOrEmpty(fotoBase64) || fotoBase64.Contains("data:,"))
            {
                esExito = false;
                mensajeResultado = "Error: La cámara no pudo capturar la imagen.";
                procesando = false;
                return;
            }

            registro.Foto = fotoBase64;

            using var client = new HttpClient();
            var respuesta = await client.PostAsJsonAsync("https://localhost:7002/api/Asistencia/registrar", registro);

            var opcionesJson = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            if (respuesta.IsSuccessStatusCode)
            {
                var resultadoOk = await respuesta.Content.ReadFromJsonAsync<RespuestaApi>(opcionesJson);
                esExito = true;
                mensajeResultado = resultadoOk?.Mensaje ?? "Operación exitosa.";
            }
            else
            {
                var errorTexto = await respuesta.Content.ReadFromJsonAsync<RespuestaApi>(opcionesJson);
                esExito = false;
                mensajeResultado = errorTexto?.Mensaje ?? "El número de empleado que registró no existe.";
            }
        }
        catch (Exception ex)
        {
            esExito = false;
            mensajeResultado = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            procesando = false;
            registro.NumeroEmpleado = "";
            await inputNumeroEmpleado.FocusAsync();
        }
    }

    public class RespuestaApi
    {
        public string Mensaje { get; set; } = "";
    }
}