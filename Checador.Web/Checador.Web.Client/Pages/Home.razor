@page "/"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@using Checador.Web.Client.Dtos
@using Checador.Web.Client.Dtos.AdminsDtos
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavigationManager

@if (verificandoSetup)
{
    <div class="vh-100 d-flex justify-content-center align-items-center bg-light">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
    </div>
}
else if (requiereSetup)
{
    <div class="vh-100 d-flex justify-content-center align-items-center" style="background-color: #f4f6f9;">
        <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-top: 5px solid #960E53;">
            <h2 class="fw-bold mb-3 text-center" style="color: #960E53;">Configuración Inicial</h2>
            <p class="text-muted text-center mb-4">No se detectaron administradores en el sistema. Registre el primer usuario con privilegios.</p>

            <EditForm Model="@nuevoAdmin" OnValidSubmit="RegistrarPrimerAdmin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre Completo</label>
                    <InputText @bind-Value="nuevoAdmin.NombreCompleto" class="form-control form-control-lg" />
                    <ValidationMessage For="@(() => nuevoAdmin.NombreCompleto)" class="text-danger small" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Número de Empleado</label>
                        <InputText @bind-Value="nuevoAdmin.NumeroEmpleado" class="form-control form-control-lg" />
                        <ValidationMessage For="@(() => nuevoAdmin.NumeroEmpleado)" class="text-danger small" />
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold">Puesto</label>
                        <InputText @bind-Value="nuevoAdmin.Puesto" class="form-control form-control-lg" />
                        <ValidationMessage For="@(() => nuevoAdmin.Puesto)" class="text-danger small" />
                    </div>
                </div>

                <div class="alert @(huellaLista ? "alert-success" : "alert-warning") text-center mb-4 border-dashed">
                    <i class="bi bi-fingerprint fs-1 @(huellaLista ? "text-success" : "text-warning") d-block mb-2"></i>
                    <strong>@estadoHuella</strong>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold shadow-sm" style="background-color: #960E53; border: none;" disabled="@procesando">
                    @if (procesando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Administrador y Finalizar</span>
                    }
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm w-100 mt-3"
                        @onclick="ForzarRegistroManual">
                    <i class="bi bi-tools"></i>
                    Crear administrador predeterminado
                </button>

                @if (!string.IsNullOrEmpty(mensajeSetup))
                {
                    <div class="alert alert-danger mt-3 text-center">@mensajeSetup</div>
                }
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="container-fluid vh-100 p-0 position-relative">

        <div class="position-absolute top-0 end-0 m-3"
             style="z-index: 1000;">
            <a href="/menu"
               class="btn btn-light fw-bold shadow-sm">
                <i class="bi bi-grid"></i>
                Menú Principal
            </a>
        </div>

        <div class="row g-0 h-100">

            <div class="col-md-6 split-left text-center"
                 style="background-color: #960E53; color: white; display: flex; flex-direction: column; justify-content: space-between; padding: 40px;">

                <div style="margin-top: 20px;">
                    <img src="@Config["UIParams:LogoPrincipal"]"
                         alt="Logo Institucional"
                         style="width: 220px; max-width: 80%;" />
                </div>

                <div>
                    <h2 class="fw-bold mb-4">@Config["UIParams:TituloPrincipal"]</h2>

                    <p class="px-5"
                       style="font-size: 1.1rem; line-height: 1.6;">
                        Sistema de asistencia institucional. Ingresa tu número de empleado y colócate frente a la cámara para registrar tu entrada o salida.
                    </p>
                </div>

                <div class="d-flex align-items-center justify-content-center text-start"
                     style="margin-bottom: 20px;">

                    <img src="@Config["UIParams:LogoSecundario"]"
                         class="me-3"
                         style="width: 130px;" alt="Logo Secundario" />

                    <div style="font-size: 0.85rem; border-left: 1px solid rgba(255,255,255,0.4); padding-left: 15px;">
                        <strong>@Config["UIParams:Subtitulo"]</strong><br />
                        @Config["UIParams:Direccion"]
                    </div>

                </div>
            </div>

            <div class="col-md-6 d-flex align-items-center justify-content-center bg-white">

                <div class="w-75 p-4">

                    <h3 class="mb-4 text-center fw-bold"
                        style="color: #333333;">
                        Registrar Asistencia
                    </h3>

                    <div class="video-container mb-4 shadow-sm"
                         style="background-color: #000; border-radius: 8px; overflow: hidden; height: 300px;">

                        <video id="videoFeed"
                               style="width: 100%;"
                               height="300"
                               autoplay
                               muted
                               playsinline>
                        </video>

                        <canvas id="canvasOculto"
                                width="400"
                                height="300"
                                style="display:none;">
                        </canvas>
                    </div>

                    <EditForm Model="@registro"
                              OnValidSubmit="ProcesarRegistro">

                        <DataAnnotationsValidator />

                        <div class="form-group mb-4 text-start">

                            <label for="numeroEmpleado"
                                   class="form-label fw-bold"
                                   style="color: #4D4D4D;">
                                Número de Empleado
                            </label>

                            <input type="text"
                                   id="numeroEmpleado"
                                   class="form-control form-control-lg text-center fw-bold"
                                   placeholder="Ingresa tu número de empleado y presiona Enter"
                                   @bind-value="registro.NumeroEmpleado"
                                   @ref="inputNumeroEmpleado"
                                   autofocus />

                            <ValidationMessage For="@(() => registro.NumeroEmpleado)"
                                               class="text-danger small" />

                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100 py-3 fw-bold fs-5 shadow-sm"
                                style="background-color: #960E53; color: white; border: none;"
                                disabled="@procesando">

                            @if (procesando)
                            {
                                <span class="spinner-border spinner-border-sm"
                                      role="status"
                                      aria-hidden="true">
                                </span>

                                <span> Procesando...</span>
                            }
                            else
                            {
                                <span>
                                    <i class="bi bi-person-check-fill"></i>
                                    Registrar
                                </span>
                            }

                        </button>

                    </EditForm>

                    @if (!string.IsNullOrEmpty(mensajeResultado))
                    {
                        <div class="alert @(esExito ? "alert-success" : "alert-danger") mt-4 fw-bold text-center"
                             role="alert">
                            @mensajeResultado
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
}

@code {
    private RegistroDto registro = new RegistroDto();
    private string mensajeResultado = "";
    private bool esExito = false;
    private bool procesando = false;

    private bool verificandoSetup = true;
    private bool requiereSetup = false;
    private RegistroAdminDto nuevoAdmin = new RegistroAdminDto();
    private string mensajeSetup = "";

    private ElementReference inputNumeroEmpleado;

    private DotNetObjectReference<Home> objRef;
    private string estadoHuella = "Esperando huella... (Coloque el dedo en el lector)";
    private bool huellaLista = false;
    private bool jsInicializado = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var respuesta = await Http.GetAsync(
                "api/Admin/requiere-setup");

            if (respuesta.IsSuccessStatusCode)
            {
                var boolString =
                    await respuesta.Content.ReadAsStringAsync();

                requiereSetup = bool.Parse(boolString);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "Error al conectar con la API: " + ex.Message);
        }
        finally
        {
            verificandoSetup = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!verificandoSetup && !jsInicializado)
        {
            jsInicializado = true;

            if (requiereSetup)
            {
                try
                {
                    objRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("lectorHuellas.iniciar", objRef);
                }
                catch
                {
                    estadoHuella = "Lector no disponible en navegador. Use el registro manual.";
                }
            }
            else
            {
                await Task.Delay(200);
                await JS.InvokeVoidAsync("iniciarCamara", "videoFeed");
            }
        }
    }

    [JSInvokable]
    public void HuellaCapturada(string huellaBase64)
    {
        nuevoAdmin.Huella = huellaBase64;
        estadoHuella = "Huella capturada.";
        huellaLista = true;
        StateHasChanged();
    }

    private async Task ForzarRegistroManual()
    {
        procesando = true;
        mensajeSetup = "";

        try
        {
            var adminDefault = new RegistroAdminDto
            {
                NombreCompleto = "Administrador del Sistema",
                NumeroEmpleado = "Admin-01",
                Puesto = "Sistemas",
                Huella = "BYPASS_SETUP_AUTOMATICO"
            };

            var respuesta = await Http.PostAsJsonAsync("api/Admin/registrar-inicial", adminDefault);

            if (respuesta.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                mensajeSetup = "No se pudo omitir el setup automáticamente. Verifica la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeSetup = $"Error: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task ProcesarRegistro()
    {
        procesando = true;
        mensajeResultado = "";

        try
        {
            string fotoBase64 = await JS.InvokeAsync<string>(
                "capturaAutomatica",
                "videoFeed",
                "canvasOculto");

            if (string.IsNullOrEmpty(fotoBase64) ||
                fotoBase64.Contains("data:,"))
            {
                esExito = false;
                mensajeResultado =
                    "Error: La cámara no pudo capturar la imagen.";
                return;
            }

            registro.Foto = fotoBase64;
            registro.ConfirmarSalidaAnticipada = false;

            var respuesta = await Http.PostAsJsonAsync("api/Asistencia/registrar", registro);

            var opcionesJson =
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

            var resultado =
                await respuesta.Content.ReadFromJsonAsync<RespuestaApi>(
                    opcionesJson);

            if (resultado?.RequiereConfirmacion == true)
            {
                bool confirmar = await JS.InvokeAsync<bool>(
                    "confirm",
                    resultado.Mensaje);

                if (!confirmar)
                {
                    esExito = false;
                    mensajeResultado =
                        "Registro de salida cancelado.";
                    return;
                }

                registro.ConfirmarSalidaAnticipada = true;

                var segundaRespuesta =
                    await Http.PostAsJsonAsync("api/Asistencia/registrar", registro);

                var resultadoConfirmado =
                    await segundaRespuesta.Content
                        .ReadFromJsonAsync<RespuestaApi>(
                            opcionesJson);

                if (segundaRespuesta.IsSuccessStatusCode)
                {
                    esExito = true;
                    mensajeResultado =
                        resultadoConfirmado?.Mensaje ??
                        "Salida registrada correctamente.";
                }
                else
                {
                    esExito = false;
                    mensajeResultado =
                        resultadoConfirmado?.Mensaje ??
                        "No fue posible registrar la salida.";
                }

                return;
            }

            if (respuesta.IsSuccessStatusCode)
            {
                esExito = resultado?.Exito ?? true;
                mensajeResultado =
                    resultado?.Mensaje ??
                    "Registro realizado correctamente.";
            }
            else
            {
                esExito = false;
                mensajeResultado =
                    resultado?.Mensaje ??
                    "No fue posible registrar la asistencia.";
            }
        }
        catch (Exception ex)
        {
            esExito = false;
            mensajeResultado =
                $"Error de conexión: {ex.Message}";
        }
        finally
        {
            procesando = false;
            registro.ConfirmarSalidaAnticipada = false;
            registro.NumeroEmpleado = "";

            await Task.Delay(100);
            await inputNumeroEmpleado.FocusAsync();
        }
    }

    private async Task RegistrarPrimerAdmin()
    {
        procesando = true;
        mensajeSetup = "";

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/Admin/registrar-inicial", nuevoAdmin);

            if (respuesta.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                mensajeSetup = "Error al registrar: Verifica que la API esté respondiendo.";
            }
        }
        catch (Exception ex)
        {
            mensajeSetup = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    public class RespuestaApi
    {
        public bool Exito { get; set; }
        public bool RequiereConfirmacion { get; set; }
        public string Mensaje { get; set; } = "";
    }
}