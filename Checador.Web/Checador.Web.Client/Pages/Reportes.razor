@page "/reportes"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Checador.Web.Client.Services.AuthState Auth
@using Checador.Web.Client.Dtos
@using Checador.Web.Client.Dtos.PermisosDtos

@if (!Auth.EstaAutenticado)
{
    <div class="p-5 text-center">Redirigiendo al login...</div>
}
else
{
    <div class="container-fluid p-0" style="min-height: 100vh;">
        <div class="row g-0" style="min-height: 100vh;">

            <div class="col-lg-5">
                <PanelInstitucional Texto="Consulta los registros de asistencia, horas trabajadas y evidencias de entrada y salida." />
            </div>

            <div class="col-lg-7" style="background-color: #f4f6f9;">
                <div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh;">
                    <div class="card shadow-lg p-4 border-0">
                        <div class="d-flex justify-content-end mb-3">
                            <a href="/admin-index" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-shield-lock"></i>
                                Panel Administrativo
                            </a>
                        </div>

                        <div class="alert alert-light border shadow-sm mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@Auth.PerfilActual!.NombreCompleto</strong>
                                    <span class="badge ms-2" style="background-color: #960E53;">
                                        @Auth.PerfilActual.Rol
                                    </span>
                                    <div class="text-muted small mt-1">
                                        @Auth.PerfilActual.NumeroEmpleado - @Auth.PerfilActual.Departamento
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h2 class="fw-bold mb-1" style="color: #960E53;">Reportes</h2>
                            </div>
                        </div>

                        <div class="row align-items-end mb-4 g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary">Empleado</label>
                                <input type="text" class="form-control" placeholder="Número o nombre..." @bind="filtroEmpleado" @bind:event="oninput" />
                            </div>

                            @if (PuedeFiltrarArea)
                            {
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary">Departamento</label>
                                    <select class="form-select" @bind="filtroDepartamento">
                                        <option value="">Todos</option>
                                        @foreach (var depto in DepartamentosDisponibles)
                                        {
                                            <option value="@depto">@depto</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="@(PuedeFiltrarArea ? "col-md-6" : "col-md-9") text-md-end">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn @(vistaActual == "dia" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("dia")'>Día</button>
                                    <button type="button" class="btn @(vistaActual == "semana" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("semana")'>Semana</button>
                                    <button type="button" class="btn @(vistaActual == "mes" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("mes")'>Mes</button>
                                    <button type="button" class="btn @(vistaActual == "ultimos30" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("ultimos30")'>Últimos 30 Días</button>
                                </div>
                                <button class="btn btn-success ms-2 fw-bold" @onclick="CargarReportes">
                                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                                </button>
                            </div>
                        </div>

                        @if (cargando)
                        {
                            <div class="text-center my-5 py-5">
                                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                                <p class="mt-3 text-muted fw-bold">Generando reporte de @vistaActual...</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive shadow-sm rounded">
                                <table class="table table-striped table-hover align-middle mb-0 bg-white">
                                    <thead class="text-white" style="background-color: #960E53;">
                                        <tr>
                                            <th class="py-3">No. Empleado</th>
                                            <th class="py-3">Nombre Completo</th>
                                            <th class="py-3">Departamento</th>
                                            <th class="py-3">Puesto</th>
                                            <th class="py-3">Horas / Registros (@vistaActual.ToUpper())</th>
                                            <th class="py-3 text-center">Evidencias</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (EmpleadosFiltrados != null && EmpleadosFiltrados.Any())
                                        {
                                            @foreach (var item in EmpleadosFiltrados)
                                            {
                                                <tr>
                                                    <td><strong>@item.NumeroEmpleado</strong></td>
                                                    <td>@item.NombreCompleto</td>
                                                    <td>@item.Departamento</td>
                                                    <td><span class="badge bg-light text-dark border">@item.Puesto</span></td>
                                                    <td><span class="fw-bold text-primary">@item.DetalleTiempo</span></td>
                                                    <td class="text-center">
                                                        <button class="btn btn-sm btn-outline-primary fw-bold" @onclick='() => AbrirModalFotos(item.NumeroEmpleado, item.NombreCompleto)'>
                                                            <i class="bi bi-images"></i> Ver Fotos
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-5">
                                                    <i class="bi bi-folder2-open fs-1 d-block mb-2"></i> No se encontraron registros de asistencia.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (mostrarModalFotos)
                {
                    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content shadow-lg">
                                <div class="modal-header" style="background-color: #960E53; color: white;">
                                    <h5 class="modal-title fw-bold">Evidencias de @empleadoSeleccionadoNombre</h5>
                                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalFotos"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-4 text-center bg-light p-3 rounded border">
                                        <label class="form-label fw-bold text-secondary mb-2">Seleccione una fecha (Últimos 30 días):</label><br />
                                        <input type="date" class="form-control d-inline-block w-auto shadow-sm" min="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="fechaSeleccionadaFotos" @bind:after="CargarFotosPorFecha" />
                                    </div>
                                    @if (cargandoFotos)
                                    {
                                        <div class="text-center py-5">
                                            <div class="spinner-border text-primary" role="status"></div>
                                            <div class="mt-2 text-muted fw-bold">Buscando evidencias fotográficas...</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-md-6 text-center mb-3">
                                                <h6 class="fw-bold text-secondary mb-3">Registro de Entrada</h6>
                                                @if (!string.IsNullOrEmpty(fotoEntradaActual))
                                                {
                                                    <img src="@fotoEntradaActual" class="img-fluid rounded shadow border" style="max-height: 280px;" alt="Entrada" />
                                                }
                                                else
                                                {

                                                    <div class="p-5 border rounded bg-white text-muted shadow-sm"><i class="bi bi-camera-video-off fs-1 d-block mb-2"></i>Sin registro</div>
                                                }
                                            </div>
                                            <div class="col-md-6 text-center mb-3">
                                                <h6 class="fw-bold text-secondary mb-3">Registro de Salida</h6>
                                                @if (!string.IsNullOrEmpty(fotoSalidaActual))
                                                {
                                                    <img src="@fotoSalidaActual" class="img-fluid rounded shadow border" style="max-height: 280px;" alt="Salida" />
                                                }
                                                else
                                                {

                                                    <div class="p-5 border rounded bg-white text-muted shadow-sm"><i class="bi bi-camera-video-off fs-1 d-block mb-2"></i>Sin registro</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalFotos">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private string vistaActual = "dia";
    private string filtroEmpleado = "";
    private string filtroDepartamento = "";
    private bool cargando = false;

    private bool mostrarModalFotos = false;
    private string empleadoSeleccionadoNumero = "";
    private string empleadoSeleccionadoNombre = "";
    private DateTime fechaSeleccionadaFotos = DateTime.Today;
    private string fotoEntradaActual = "";
    private string fotoSalidaActual = "";
    private bool cargandoFotos = false;

    private List<ReporteAsistenciaDto> listaReporte = new();

    private bool PuedeFiltrarArea => Auth.PerfilActual?.Rol == "RRHH" || Auth.PerfilActual?.Rol == "RRHHAdmin" || Auth.PerfilActual?.Rol == "Admin";

    private IEnumerable<string> DepartamentosDisponibles => listaReporte.Select(x => x.Departamento).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d);

    private IEnumerable<ReporteAsistenciaDto> EmpleadosFiltrados
    {
        get
        {
            var query = listaReporte.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtroDepartamento)) query = query.Where(x => x.Departamento == filtroDepartamento);
            if (!string.IsNullOrWhiteSpace(filtroEmpleado)) query = query.Where(x => x.NumeroEmpleado.Contains(filtroEmpleado, StringComparison.OrdinalIgnoreCase) || x.NombreCompleto.Contains(filtroEmpleado, StringComparison.OrdinalIgnoreCase));
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EstaAutenticado)
        {
            NavManager.NavigateTo("/login");
        }
        else
        {
            await CargarReportes();
        }
    }

    private async Task CambiarVista(string vista) { vistaActual = vista; await CargarReportes(); }

    private async Task CargarReportes()
    {
        cargando = true;
        try
        {
            string url = $"api/Asistencia/reporte?tipo={vistaActual}&numeroSolicitante={Auth.PerfilActual!.NumeroEmpleado}";
            listaReporte = await Http.GetFromJsonAsync<List<ReporteAsistenciaDto>>(url) ?? new();
        }
        catch (Exception) { listaReporte = new(); }
        finally { cargando = false; }
    }

    private async Task AbrirModalFotos(string numeroEmpleado, string nombreCompleto)
    {
        empleadoSeleccionadoNumero = numeroEmpleado;
        empleadoSeleccionadoNombre = nombreCompleto;
        fechaSeleccionadaFotos = DateTime.Today;
        mostrarModalFotos = true;
        await CargarFotosPorFecha();
    }

    private async Task CargarFotosPorFecha()
    {
        cargandoFotos = true;
        fotoEntradaActual = ""; fotoSalidaActual = "";
        try
        {
            string fechaStr = fechaSeleccionadaFotos.ToString("yyyy-MM-dd");
            var respuesta = await Http.GetFromJsonAsync<RespuestaFotosDto>($"api/Asistencia/fotos/{empleadoSeleccionadoNumero}?fecha={fechaStr}");
            if (respuesta != null) { fotoEntradaActual = respuesta.FotoEntrada; fotoSalidaActual = respuesta.FotoSalida; }
        }
        catch (Exception) { }
        finally { cargandoFotos = false; }
    }

    private void CerrarModalFotos() { mostrarModalFotos = false; fotoEntradaActual = ""; fotoSalidaActual = ""; }

    public class RespuestaFotosDto { public string FotoEntrada { get; set; } = ""; public string FotoSalida { get; set; } = ""; }
}