@page "/reportes"
@using System.Net.Http.Json
@inject HttpClient Http
@using Checador.Web.Client.Dtos

<div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh;">
    <div class="card shadow-lg p-4 border-0">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="color: #960E53;">Reportes</h2>
            </div>
            <div>
                <a href="/" class="btn btn-outline-secondary fw-bold">
                    <i class="bi bi-house-door"></i> Volver al Checador
                </a>
            </div>
        </div>

        <div class="row align-items-center mb-4 g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Filtrar por Empleado (Número o Nombre)</label>
                <input type="text" class="form-control" placeholder="Escribe para filtrar..." @bind="filtroEmpleado" @bind:event="oninput" />
            </div>

            <div class="col-md-8 text-md-end">
                <div class="btn-group" role="group">
                    <button type="button" class="btn @(vistaActual == "día" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("dia")'>Día</button>
                    <button type="button" class="btn @(vistaActual == "semana" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("semana")'>Semana</button>
                    <button type="button" class="btn @(vistaActual == "mes actual" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("mes")'>Mes</button>
                    <button type="button" class="btn @(vistaActual == "ultimos 30 días" ? "btn-dark text-white" : "btn-outline-dark")" @onclick='() => CambiarVista("ultimos30")'>Últimos 30 Días</button>
                </div>
                <button class="btn btn-success ms-2 fw-bold" @onclick="CargarReportes">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center my-5 py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3 text-muted fw-bold">Generando reporte de @vistaActual...</p>
            </div>
        }
        else
        {
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-striped table-hover align-middle mb-0 bg-white">
                    <thead class="text-white" style="background-color: #960E53;">
                        <tr>
                            <th class="py-3">No. Empleado</th>
                            <th class="py-3">Nombre Completo</th>
                            <th class="py-3">Puesto</th>
                            <th class="py-3">Horas / Registros (@vistaActual.ToUpper())</th>
                            <th class="py-3 text-center">Evidencia Fotográfica</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (EmpleadosFiltrados != null && EmpleadosFiltrados.Any())
                        {
                            @foreach (var item in EmpleadosFiltrados)
                            {
                                <tr>
                                    <td><strong>@item.NumeroEmpleado</strong></td>
                                    <td>@item.NombreCompleto</td>
                                    <td><span class="badge bg-light text-dark border">@item.Puesto</span></td>
                                    <td>
                                        <span class="fw-bold text-primary">@item.DetalleTiempo</span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.FotoBase64))
                                        {
                                            <button class="btn btn-sm btn-outline-primary fw-bold" @onclick="() => MostrarFoto(item.FotoBase64)">
                                                <i class="bi bi-camera"></i> Ver Foto
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin foto</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
                                    No se encontraron registros de asistencia para este periodo o filtro.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (mostrarModalFoto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header" style="background-color: #960E53; color: white;">
                    <h5 class="modal-title fw-bold">Evidencia de Asistencia</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-content-body text-center p-4">
                    <img src="@fotoSeleccionada" class="img-fluid rounded shadow border" style="max-height: 400px;" alt="Foto de asistencia" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string vistaActual = "dia";
    private string filtroEmpleado = "";
    private bool cargando = true;

    private bool mostrarModalFoto = false;
    private string fotoSeleccionada = "";

    private List<ReporteAsistenciaDto> listaReporte = new();

    private IEnumerable<ReporteAsistenciaDto> EmpleadosFiltrados =>
        string.IsNullOrWhiteSpace(filtroEmpleado)
            ? listaReporte
            : listaReporte.Where(x =>
                x.NumeroEmpleado.Contains(filtroEmpleado, StringComparison.OrdinalIgnoreCase) ||
                x.NombreCompleto.Contains(filtroEmpleado, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarReportes();
    }

    private async Task CambiarVista(string vista)
    {
        vistaActual = vista;
        await CargarReportes();
    }

    private async Task CargarReportes()
    {
        cargando = true;
        try
        {
            listaReporte = await Http.GetFromJsonAsync<List<ReporteAsistenciaDto>>($"https://localhost:7002/api/Asistencia/reporte?tipo={vistaActual}") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar reportes: " + ex.Message);
            listaReporte = new();
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarFoto(string foto)
    {
        fotoSeleccionada = foto;
        mostrarModalFoto = true;
    }

    private void CerrarModal()
    {
        mostrarModalFoto = false;
        fotoSeleccionada = "";
    }

}