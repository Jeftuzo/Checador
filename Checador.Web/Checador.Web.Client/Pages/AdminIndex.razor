@page "/admin-index"
@layout Checador.Web.Client.Layout.EmptyNavMenu
@inject NavigationManager NavManager
@inject Checador.Web.Client.Services.AuthState Auth

@if (!Auth.EstaAutenticado)
{
    <div class="p-5 text-center">Redirigiendo al login...</div>
}
else
{
    <div class="container-fluid p-0" style="min-height: 100vh;">
        <div class="row g-0" style="min-height: 100vh;">

            <div class="col-lg-5">
                <PanelInstitucional Texto="Panel de control administrativo para la gestión de autorizaciones y reportes." />
            </div>

            <div class="col-lg-7 d-flex flex-column" style="background-color: #f4f6f9;">

                <div class="w-100 p-4 p-md-5 pb-0">
                    <div class="alert alert-light border shadow-sm mb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1" style="color: #960E53;">Panel Administrativo</h5>
                                <strong>@Auth.PerfilActual?.NombreCompleto</strong>
                                <span class="badge ms-2" style="background-color: #960E53;">@Auth.PerfilActual?.Rol</span>
                                <div class="text-muted small mt-1">@Auth.PerfilActual?.NumeroEmpleado - @Auth.PerfilActual?.Departamento</div>
                            </div>
                            <button class="btn btn-outline-danger fw-bold shadow-sm" @onclick="CerrarSesion">
                                <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center w-100 pb-5">
                    <div class="container px-4 w-100">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold" style="color: #960E53;">Módulos de Administración</h2>
                            <p class="text-muted">Seleccione el módulo al que desea acceder</p>
                        </div>

                        <div class="row g-4 justify-content-center">

                            <div class="col-md-5">
                                <div class="card shadow border-0 h-100 text-center p-4">
                                    <div class="mb-3">
                                        <i class="bi bi-ui-checks" style="font-size: 3.5rem; color: #960E53;"></i>
                                    </div>
                                    <h4 class="fw-bold">Autorizaciones</h4>
                                    <p class="text-muted small">Revisar y gestionar solicitudes de permisos del personal.</p>
                                    <a href="/autorizar-permisos" class="btn text-white fw-bold mt-auto" style="background-color: #960E53;">
                                        Ir a Autorizaciones
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <div class="card shadow border-0 h-100 text-center p-4">
                                    <div class="mb-3">
                                        <i class="bi bi-bar-chart-fill" style="font-size: 3.5rem; color: #960E53;"></i>
                                    </div>
                                    <h4 class="fw-bold">Reportes</h4>
                                    <p class="text-muted small">Consultar asistencia, horas y evidencias fotográficas.</p>
                                    <a href="/reportes" class="btn text-white fw-bold mt-auto" style="background-color: #960E53;">
                                        Ir a Reportes
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Auth.EstaAutenticado)
        {
            NavManager.NavigateTo("/login");
        }
    }

    private void CerrarSesion()
    {
        Auth.CerrarSesion();
        NavManager.NavigateTo("/menu");
    }
}